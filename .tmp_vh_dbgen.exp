#!/usr/bin/expect -f
set timeout 240
cd /Users/xueyd/dev/VoiceHub
log_user 1
spawn pnpm exec drizzle-kit generate --name=auto-migration
set timeout 10
expect {
    -re {created or renamed from another column} {
        send "\r"
        exp_continue
    }
    timeout {
        exp_continue
    }
    eof
}